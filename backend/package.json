{
  "name": "raaah-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RAAAH Backend API Server (Node.js + Express.js) - SRS Section 4, Component Diagram Fig. 37",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:local": "node src/db/localPostgres.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "seed:crowd": "node src/db/seed.js --crowd-only",
    "test": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:unit": "node --import ./tests/setup.js --test \"tests/unit/*.test.js\"",
    "test:integration": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:coverage": "node --import ./tests/setup.js --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"tests/**\" \"tests/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "pg": "8.16.3",
    "redis": "5.8.2"
  },
  "optionalDependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  }
}
