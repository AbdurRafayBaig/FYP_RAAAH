# ---------------------------------------------
# RAAAH Backend configuration
# Copy this file to .env and adjust the values.
# ---------------------------------------------

PORT=5000
# Address of the web client. Several can be given, separated by commas.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (SRS: PostgreSQL + PostGIS).
# The default points to the local server started by `npm run db:local`.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/raaah

# Redis cache for crowd levels and destination status (SRS 3.3.7).
# Leave empty to use the built-in in-memory cache during development.
REDIS_URL=

# Authentication
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# AI Recommendation Engine (Python + Scikit-learn)
AI_ENGINE_URL=http://localhost:8000

# OpenWeatherMap API (FR-02.06). Without a key the last stored weather is shown with its update time.
OPENWEATHER_API_KEY=
WEATHER_REFRESH_MINUTES=10

# Crowd Monitoring (FR-03.02, FR-03.04)
CHECKIN_AUTO_CLOSE_HOURS=6
CROWD_REFRESH_SECONDS=60
