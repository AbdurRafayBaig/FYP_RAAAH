# ---------------------------------------------
# RAAAH deployment settings (docker compose)
# Copy this file to .env in this folder and fill it in. Never commit .env.
# ---------------------------------------------

# Public address of the site: a domain name that points to this server (e.g. raaah.example.pk),
# or "localhost" to try the deployment on your own machine.
SITE_ADDRESS=localhost

# Database password. Use letters and digits only (it is placed inside a connection URL).
POSTGRES_PASSWORD=

# Secret used to sign login sessions. Use a long random value, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# OpenWeatherMap API key (FR-02.06). Without it the last stored weather is shown with its update time.
OPENWEATHER_API_KEY=
WEATHER_REFRESH_MINUTES=10

# Google Maps JavaScript API key (FR-02.02). Without it a keyless Google Maps embed is shown.
# Restrict the key to SITE_ADDRESS in the Google Cloud console: it is visible in the browser.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Crowd Monitoring (FR-03.02, FR-03.04)
CHECKIN_AUTO_CLOSE_HOURS=6
CROWD_REFRESH_SECONDS=60
