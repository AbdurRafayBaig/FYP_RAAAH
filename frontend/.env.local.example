# Copy to .env.local
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps JavaScript API key (FR-02.02). Without it a keyless Google Maps embed is shown.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID for advanced markers (DEMO_MAP_ID works for development)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
